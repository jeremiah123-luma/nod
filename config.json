{
  "camera": {
    "index": 0,
    "width": 640,
    "height": 480,
    "fps": 30
  },
  "pointer": {
    "gain_x": 70,
    "gain_y": 60,
    "invert_x": false,
    "invert_y": false,
    "acceleration": 0.1,
    "edge_margin_px": 1,
    "filter_min_cutoff": 0.3,
    "filter_beta": 0.3,
    "filter_d_cutoff": 0.8,
    "filter_speed_floor": 3.0,
    "source": "matrix",
    "matrix_units_per_sin": 45,
    "still_radius_px": 14.0,
    "still_ms": 300,
    "deadzone_px": 12.0
  },
  "hotkeys": {
    "pause": "<ctrl>+<alt>+p",
    "recenter": "<ctrl>+<alt>+c",
    "quit": "<ctrl>+<alt>+q",
    "dwell_toggle": "<ctrl>+<alt>+d",
    "gaze_toggle": "<ctrl>+<alt>+g",
    "voice_toggle": "<ctrl>+<alt>+v",
    "calibrate": "<ctrl>+<alt>+k"
  },
  "hud": {
    "window_name": "Nod (q = quit, c = recenter)"
  },
  "click": {
    "blendshape": "jawOpen",
    "threshold": 0.5,
    "release_threshold": 0.25,
    "hold_ms": 250,
    "cooldown_ms": 600
  },
  "dwell": {
    "enabled": false,
    "dwell_ms": 600,
    "radius_px": 12
  },
  "scroll": {
    "cooldown_ms": 900,
    "settle_ms": 500,
    "deadzone": 4.0,
    "gain": 1.2,
    "max_clicks_per_s": 30,
    "invert": false,
    "toggle_gesture": "brows",
    "gestures": {
      "brows": {
        "blendshape": "browInnerUp",
        "delta": 0.3,
        "release_delta": 0.12,
        "hold_ms": 350
      },
      "pucker": {
        "blendshape": "mouthPucker",
        "delta": 0.35,
        "release_delta": 0.15,
        "hold_ms": 350
      }
    },
    "neutral_ms": 1200,
    "gate_pitch_window": 6.0,
    "gate_max_head_speed_px_s": 60,
    "gate_settle_ms": 400
  },
  "gaze": {
    "enabled": true,
    "calibration_file": "gaze_calibration.json",
    "ridge": 0.1,
    "grid_margin": 0.08,
    "settle_ms": 600,
    "collect_ms": 1200,
    "smooth_min_cutoff": 0.8,
    "smooth_beta": 0.005,
    "min_jump_fraction": 0.2,
    "stable_radius_fraction": 0.1,
    "dwell_ms": 450,
    "max_head_speed_px_s": 150,
    "cooldown_ms": 1200,
    "blink_threshold": 0.5,
    "model": "auto",
    "passes": 2,
    "stable_fraction": 0.7
  },
  "voice": {
    "enabled": false,
    "model": "base.en",
    "language": "en",
    "max_seconds": 8,
    "scroll_clicks": 10
  }
}
